# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TMDB (film/TV metadata)
NEXT_PUBLIC_TMDB_API_KEY=

# OMDb (Rotten Tomatoes ratings) — free tier: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# MooreMetrics MovieDive (similar-film recommendations)
MOOREMETRICS_API_KEY=

# Vercel Blob — auto-injected by Vercel once Blob storage is connected to the project;
# only needs to be set manually here for local dev (`vercel env pull` will fetch it).
BLOB_READ_WRITE_TOKEN=

# Cron auth — set this in Vercel's env vars (Production + Preview). Vercel automatically
# sends `Authorization: Bearer $CRON_SECRET` on cron-triggered requests, so nothing
# sensitive needs to live in vercel.json. Generate with: openssl rand -hex 32
CRON_SECRET=
